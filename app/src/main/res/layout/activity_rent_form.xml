<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RentForm"
    android:background="#FFD93D"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded"
            android:padding="5dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="60dp"
            android:id="@+id/Personal"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" تاریخ :"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:layout_marginTop="15dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:id="@+id/Date"
                />

            <TextView
                android:id="@+id/Day"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="10dp"
                android:text="18"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp"
                android:layout_toStartOf="@+id/Date"
                android:gravity="right"/>
            <TextView
                android:id="@+id/slash1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:layout_toStartOf="@+id/Day"
                android:layout_marginTop="15dp"
                android:textColor="@color/white"
                android:textSize="20sp"

                />

            <TextView
                android:id="@+id/Month"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="10dp"
                android:text="02"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp"
                android:layout_toStartOf="@+id/slash1"
                android:gravity="right"
                />
            <TextView
                android:id="@+id/slash2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:layout_toStartOf="@+id/Month"
                android:layout_marginTop="15dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginRight="5dp"/>

            <TextView
                android:id="@+id/Year"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="10dp"
                android:text="1402"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp"
                android:layout_toStartOf="@+id/slash2"
                android:gravity="right"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="موجر"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:id="@+id/buyer"
                android:layout_below="@+id/Year"
                android:layout_marginTop="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/BuyerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_toStartOf="@+id/buyer"
                android:layout_below="@+id/Year"
                android:textColor="@color/white"
                android:layout_marginRight="10dp"
                android:gravity="right"
                android:text="نیما سلیمی"
                android:layout_marginTop="10dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فرزند"
                android:layout_toStartOf="@+id/BuyerName"
                android:layout_marginTop="10dp"
                android:id="@+id/ChildOf"
                android:layout_below="@+id/Year"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginRight="10dp"
                />

            <TextView
                android:id="@+id/ChildOfName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_toStartOf="@+id/ChildOf"
                android:layout_below="@+id/Year"
                android:textColor="@color/white"
                android:layout_marginRight="10dp"
                android:gravity="right"
                android:text="علی"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="شماره شناسنامه"
                android:id="@+id/IdCode"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/Date"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginRight="10dp"
                android:layout_toStartOf="@+id/ChildOfName"
                />

            <TextView
                android:id="@+id/IdCodeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/IdCode"
                android:textSize="15sp"
                android:text="251"
                android:layout_below="@+id/Date"
                android:textColorHint="@color/white"
                android:layout_marginRight="10dp"
                android:gravity="right"
                android:layout_marginTop="15dp"
                android:textColor="@color/white"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صادره از"
                android:id="@+id/From"
                android:layout_toStartOf="@+id/ChildOfName"
                android:layout_below="@+id/IdCode"
                android:layout_marginTop="20dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/FormValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/From"
                android:layout_below="@id/IdCode"
                android:layout_marginTop="18dp"
                android:textSize="15sp"
                android:layout_marginRight="10dp"
                android:gravity="right"
                android:text="سقز"
                android:textColor="@color/white"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کد ملی"
                android:id="@+id/Meli"
                android:layout_toStartOf="@+id/FormValue"
                android:layout_below="@+id/IdCodeValue"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                />

            <TextView
                android:id="@+id/MeliCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/Meli"
                android:layout_below="@id/IdCodeValue"
                android:layout_marginTop="20dp"
                android:textSize="15sp"
                android:inputType="number"
                android:layout_marginRight="10dp"
                android:gravity="right"
                android:text="3750402477"
                android:textColor="@color/white"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متولد"
                android:id="@+id/Born"
                android:layout_toStartOf="@+id/MeliCode"
                android:layout_below="@+id/IdCodeValue"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                />

            <TextView
