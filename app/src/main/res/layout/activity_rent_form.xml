                android:layout_below="@+id/Address"
                android:layout_toStartOf="@+id/PostCodeValue"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"/>

            <TextView
