<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="5dp"
    app:cardCornerRadius="20sp"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="10dp"
    android:foreground="?attr/selectableItemBackground"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/rounded"
        android:layout_marginTop="70dp">



        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:cardCornerRadius="300sp"
            android:background="#27272D"
            android:id="@+id/Image"
            >
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/ImageProf"
                android:maxHeight="45dp"
                android:maxWidth="45dp"
                android:src="@drawable/building"
                />




        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#434242"
            android:layout_below="@+id/Image"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/NameText"
            android:text="@string/CustomerName"
            android:textSize="18dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"
            android:textColor="@color/white"
            android:layout_marginTop="25dp"
            android:layout_below="@+id/Image"
            android:layout_alignParentRight="true"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/NameView"
            android:layout_below="@+id/Image"
            android:layout_toStartOf="@+id/NameText"
            android:layout_marginTop="25dp"
            android:layout_marginRight="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#434242"
            android:layout_below="@+id/NameText"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/CodeID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/NameText"
            android:layout_alignParentRight="true"
            android:text="@string/CustomerIdCode"
            android:layout_marginTop="25dp"
            android:textSize="18sp"
            android:textColor="@color/white"/>


        <TextView
            android:id="@+id/CodeMeli"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/NameText"
            android:layout_toStartOf="@+id/CodeID"
            android:layout_marginTop="25dp"
            android:gravity="right"
            android:text=""
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_marginRight="10dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#434242"
            android:layout_below="@+id/CodeID"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Mobile"
            android:text="@string/Mobile"
            android:layout_below="@id/CodeID"
            android:layout_marginTop="25dp"
            android:layout_alignParentRight="true"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/MobileNumber"
            android:text=""
            android:layout_below="@id/CodeID"
            android:layout_marginTop="25dp"
            android:layout_toStartOf="@+id/Mobile"
            android:layout_marginRight="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#434242"
            android:layout_below="@+id/Mobile"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Email"
            android:text="@string/CustomerEmail"
            android:layout_below="@id/Mobile"
            android:layout_marginTop="25dp"
            android:layout_alignParentRight="true"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/EmailValue"
            android:text=""
            android:layout_below="@id/Mobile"
            android:layout_marginTop="25dp"
            android:layout_toStartOf="@+id/Email"
            android:layout_marginRight="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#434242"
            android:layout_below="@+id/Email"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Address"
            android:text="@string/CustomerAddress"
            android:layout_below="@id/Email"
            android:layout_marginTop="25dp"
            android:layout_alignParentRight="true"
            android:textSize="18sp"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/AddressValue"
            android:text=""
            android:layout_below="@id/Email"
            android:layout_marginTop="25dp"
            android:layout_toStartOf="@+id/Address"
            android:layout_marginRight="10dp"
            android:textSize="18sp"
            android:textColor="@color/white"/>

    </RelativeLayout>




</androidx.coordinatorlayout.widget.CoordinatorLayout>